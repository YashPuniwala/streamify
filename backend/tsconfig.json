{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "baseUrl": "src",
        "outDir": "dist",
        "sourceMap": true,
        "noImplicitAny": true,
        "lib": ["ES2020"],
        "types": ["node"],
        "skipLibCheck": true,
    },
    "include": ["src/**/*"]
}